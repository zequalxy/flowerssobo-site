# Скопируйте этот файл в .env.local и подставьте реальные значения.

# --- Posiflora (основной адресат заявки) ---------------------------------
# Без этих переменных интеграция считается ненастроенной: заявка уходит
# только в Telegram, как это работало до Posiflora.

# База API вместе с /api и без хвостового слэша.
POSIFLORA_API_URL=https://your-account.posiflora.com/api
POSIFLORA_USERNAME=manager@example.com
POSIFLORA_PASSWORD=

# UUID точки продаж (stores). Обязателен: без него заказ создать нельзя.
# Где взять UUID — README, раздел «Как найти идентификаторы Posiflora».
POSIFLORA_STORE_ID=

# UUID источника заказа (order-sources) — заведите в Posiflora источник
# «Сайт», чтобы заявки с сайта отделялись от офлайновых. Необязателен.
POSIFLORA_SOURCE_ID=

# UUID сотрудника (workers), от имени которого создаётся заказ. Необязателен:
# по умолчанию берётся сотрудник той учётки, под которой выполнен логин.
POSIFLORA_WORKER_ID=

# Префикс номера документа. Необязателен, по умолчанию «site»: номер
# получается вида site53da7243 и отделяет заказы с сайта от заведённых на
# кассе. Posiflora требует непустой docNo не длиннее 12 символов, поэтому
# номер присваивается на нашей стороне. Из префикса берутся только
# строчные латинские буквы и цифры, не больше шести.
POSIFLORA_DOC_PREFIX=

# --- Telegram (уведомление о новом заказе) -------------------------------
# 1. Создайте бота через @BotFather, скопируйте токен.
# 2. Узнайте свой chat_id (напишите боту @userinfobot, либо своему боту,
#    затем откройте https://api.telegram.org/bot<TOKEN>/getUpdates).
# chat_id получателя; несколько — через запятую.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно. 1 — заявки хранятся в Posiflora, в Telegram уходит только
# уведомление «новая заявка» с номером заказа, без персональных данных.
# ВКЛЮЧАТЬ ТОЛЬКО там, где подключена интеграция с Posiflora: без неё заявка
# целиком потеряется.
TELEGRAM_NOTIFY_ONLY=

# Необязательно. Адрес прокси/зеркала Bot API, если хостинг не выпускает
# трафик к api.telegram.org напрямую (по умолчанию https://api.telegram.org).
TELEGRAM_API_BASE=
